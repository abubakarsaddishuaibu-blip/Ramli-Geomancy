# Copy to .env (or set as repo env vars) before running/deploying.
# NEVER commit real secrets. The frontend never receives any of these values.

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Paystack (dashboard -> API keys) ---
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
# Optional override, defaults to https://api.paystack.co
PAYSTACK_BASE_URL=https://api.paystack.co

# --- App ---
# Long random string used to sign session tokens
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
# Public base URL used for Paystack callback redirect
APP_BASE_URL=https://your-domain.example
# One-time registration fee in kobo (₦15,000 = 1500000)
REGISTRATION_FEE_KOBO=1500000
REGISTRATION_FEE_CURRENCY=NGN
SESSION_TTL_SECONDS=43200
